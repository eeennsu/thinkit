// alias 테이블은 scaffold.mjs가 tsconfig paths에서 파생한다. 이 파일이 아니라
// tsconfig.json을 고친다. 손으로 관리하는 alias 테이블 둘은 어긋나고, 그 어긋남은
// 조용하다.
module.exports = {
  presets: ['{{babelPreset}}'],
  plugins: [
    [
      'module-resolver',
      {
        root: ['./'],
        alias: {{aliasJson}},
        extensions: ['.ts', '.tsx', '.js', '.jsx', '.json'],
      },
    ],
  ],
};
