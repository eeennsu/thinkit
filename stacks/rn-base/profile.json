{
  "name": "rn-base",
  "abstract": true,
  "fsdRoot": "src/",
  "routingRoot": null,
  "alias": {
    "@": "src"
  },
  "resolver": {
    "name": "babel-module",
    "settings": {
      "babel-module": {}
    },
    "devDependency": "eslint-import-resolver-babel-module",
    "why": "React Native는 alias를 tsconfig paths가 아니라 babel-plugin-module-resolver로 푼다. 리졸버는 하나만 설정한다. 둘을 섞으면 해석 실패의 원인이 모호해진다. 리졸버가 babel.config.js를 읽으므로 거기 적힌 preset이 설치되어 있어야 한다 — 아니면 eslint가 조용히 통과하는 대신 MODULE_NOT_FOUND로 죽는다."
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-plugin-boundaries": "^7",
    "eslint-import-resolver-babel-module": "^5",
    "babel-plugin-module-resolver": "^5",
    "typescript-eslint": "^8",
    "typescript": "^5",
    "eslint-plugin-react-hooks": "^7",
    "prettier": "^3",
    "@ianvs/prettier-plugin-sort-imports": "^4"
  },
  "files": [
    {
      "template": "templates/eslint.config.mjs.hbs",
      "dest": "eslint.config.mjs"
    },
    {
      "template": "templates/eslint.config.boundaries.mjs.hbs",
      "dest": "eslint.config.boundaries.mjs"
    },
    {
      "template": "templates/tsconfig.json.hbs",
      "dest": "tsconfig.json"
    },
    {
      "template": "templates/prettier.config.mjs.hbs",
      "dest": "prettier.config.mjs"
    },
    {
      "template": "stacks/rn-base/configs/babel.config.js.hbs",
      "dest": "babel.config.js"
    }
  ]
}
