{
  "name": "next",
  "fsdRoot": "src/",
  "routingRoot": "app/",
  "alias": { "@": "src" },
  "resolver": {
    "name": "typescript",
    "settings": { "typescript": { "alwaysTryTypes": true } },
    "devDependency": "eslint-import-resolver-typescript",
    "why": "alias는 tsconfig paths에서 온다."
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-plugin-boundaries": "^7",
    "eslint-import-resolver-typescript": "^4",
    "typescript-eslint": "^8",
    "typescript": "^5",
    "eslint-plugin-react-hooks": "^7",
    "prettier": "^3",
    "@ianvs/prettier-plugin-sort-imports": "^4"
  },
  "files": [
    { "template": "templates/eslint.config.mjs.hbs", "dest": "eslint.config.mjs" },
    { "template": "templates/eslint.config.boundaries.mjs.hbs", "dest": "eslint.config.boundaries.mjs" },
    { "template": "templates/tsconfig.json.hbs", "dest": "tsconfig.json" },
    { "template": "templates/prettier.config.mjs.hbs", "dest": "prettier.config.mjs" }
  ]
}
