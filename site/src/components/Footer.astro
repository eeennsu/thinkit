---
// 라이선스는 페이지가 아니라 사이트 전체에 대한 사실이라 푸터에 산다. 랜딩에만 적으면
// 다른 페이지에 들어온 사람은 이 문서와 코드가 무슨 조건으로 쓰이는지 알 수 없다.
//
// Starlight 기본 푸터(편집 링크·갱신 시각·페이지 이동)는 그대로 두고 아래에 한 줄만 더한다.
// 덮어쓰면 여기서 다시 만들어야 하는 것이 셋 생기고, 그 셋은 Starlight를 올릴 때마다 갈라진다.
import Default from "@astrojs/starlight/components/Footer.astro";
// LICENSE는 사이트 라우트가 없다. GitHub 주소를 여기 적으면 사본이 둘이 되므로 로더가
// 소유한 상수에서 가져온다 — 레포를 옮기면 이 링크도 함께 옮겨간다.
import { GITHUB_BLOB } from "../loaders/repo-docs.mjs";
---

<Default {...Astro.props}><slot /></Default>
<p class="thinkit-license">
  <a href={`${GITHUB_BLOB}/LICENSE`}>MIT 라이선스</a>
</p>

<style>
  .thinkit-license {
    margin-top: 1.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
